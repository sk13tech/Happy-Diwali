# ─── Google AdSense ───────────────────────────────────────────────
# 1. Copy this file to ".env"
# 2. Paste your AdSense publisher ID & display-ad slot ID:
#       AdSense dashboard → Ads → Ad units → your unit → code snippet
# 3. Run `npm run build` again — ads go live in the reserved slot,
#    loading only when scrolled into view (no layout shift, no CLS).

VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT=1234567890
